PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==============================================================================
# DATABASE: SUPABASE (PostgreSQL)
# ==============================================================================
# ไปที่ Supabase Dashboard > Project Settings > Database > Connection String (URI)

# 1. DATABASE_URL (โหมด Transaction Pooler พอร์ต 6543 สำหรับแอปพลิเคชันรันทั่วไป)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# 2. DIRECT_URL (โหมด Session พอร์ต 5432 สำหรับรันคำสั่ง prisma migrate)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ==============================================================================
# CACHE: UPSTASH REDIS (หรือ Local Redis)
# ==============================================================================
# Upstash REST API Mode
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# (Optional) TCP Local Redis
REDIS_URL="redis://localhost:6379"

# ==============================================================================
# SECURITY (JWT)
# ==============================================================================
# Generate a unique random secret of at least 32 characters before starting the server.
JWT_SECRET=""
JWT_EXPIRES_IN=1d

# Private Supabase Storage bucket for merchant verification documents
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
MERCHANT_DOCUMENTS_BUCKET=merchant-applications

# FEATURE FLAG: set to false to allow merchant registration without documents (dev/testing)
# Default is true (require documents)
MERCHANT_REQUIRE_DOCUMENTS=true

# Set only while running `npm run staff:bootstrap`; never commit real credentials.
BOOTSTRAP_STAFF_EMAIL=""
BOOTSTRAP_STAFF_PASSWORD=""
BOOTSTRAP_STAFF_NAME=""
BOOTSTRAP_STAFF_ROLE=ADMIN

# ==============================================================================
# MOCK AUTHENTICATION (global testing; only DB accounts marked test/demo/synthetic are eligible)
# ===============================================================================
# AI FRAUD DETECTION ENGINE (Zero-Token Gating + Gemini Flash)
# ==============================================================================
AI_PROVIDER=gemini
AI_FRAUD_API_KEY=""
AI_FRAUD_MODEL=gemini-1.5-flash
AI_FRAUD_ENDPOINT=""
