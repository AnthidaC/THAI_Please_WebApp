PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
# ตัวอย่าง Local:
DATABASE_URL="postgresql://postgres:password@localhost:5432/thai_please_db?schema=public"

# ตัวอย่าง Cloud ภายนอก (Supabase, Neon, AWS RDS, Render, Railway):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# ==============================================================================
# CACHE (Redis) - เลือกใช้อย่างใดอย่างหนึ่ง
# ==============================================================================
# แบบที่ 1: Upstash Redis (REST API mode - แนะนำสำหรับ Cloud / Serverless)
# ก๊อปปี้ค่าจากหน้า Upstash Console ได้โดยตรง:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# แบบที่ 2: Standard TCP Redis / Local Docker (ถ้าใช้แบบที่ 1 ด้านบน ไม่ต้องใส่ตัวนี้ก็ได้)
REDIS_URL="redis://localhost:6379"

# ==============================================================================
# SECURITY (JWT)
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d
