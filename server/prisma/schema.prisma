  user_rewards user_rewards[]

  @@index([campaign_id], map: "idx_quests_campaign")
  @@index([starts_at, ends_at], map: "idx_quests_date_range")
  @@index([reward_id], map: "idx_quests_reward")
  @@index([status], map: "idx_quests_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model recommendation_logs {
  recommendation_id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String    @db.Uuid
  merchant_id             String    @db.Uuid
  user_latitude           Decimal   @db.Decimal(10, 8)
  user_longitude          Decimal   @db.Decimal(11, 8)
  recommendation_score    Decimal   @db.Decimal(6, 3)
  is_clicked              Boolean   @default(false)
  is_converted_to_payment Boolean   @default(false)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  merchants               merchants @relation(fields: [merchant_id], references: [merchant_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_recommendation_logs_merchant")
  users                   User      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_recommendation_logs_user")

  @@index([is_clicked, is_converted_to_payment], map: "idx_recommendation_logs_conversion")
  @@index([merchant_id], map: "idx_recommendation_logs_merchant")
  @@index([user_id, created_at], map: "idx_recommendation_logs_user_created_at")
}

