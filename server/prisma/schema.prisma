generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  user_id                                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  citizen_id_hash                             String                      @unique(map: "uq_users_citizen_id_hash") @db.VarChar(255)
  full_name                                   String                      @db.VarChar(100)
  province_code                               String                      @db.VarChar(10)
  is_registered_thai_plus                     Boolean                     @default(false)
  created_at                                  DateTime                    @default(now()) @db.Timestamptz(6)
  recommendation_logs                         recommendation_logs[]
  referrals_referrals_referred_user_idTousers referrals[]                 @relation("referrals_referred_user_idTousers")
  referrals_referrals_referrer_user_idTousers referrals[]                 @relation("referrals_referrer_user_idTousers")
  reviews                                     reviews[]
  transactions                                transactions[]
  user_badges                                 user_badges[]
  user_category_preferences                   user_category_preferences[]
  user_quests                                 user_quests[]
  user_rewards                                user_rewards[]
  wallets                                     wallets?

  @@index([province_code], map: "idx_users_province_code")
  @@map("users")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model badges {
  badge_id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  badge_name     String        @db.VarChar(100)
  badge_level    String        @db.VarChar(20)
  description    String?
  condition_type String        @db.VarChar(50)
  required_count Int
  status         String        @default("active") @db.VarChar(20)
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  user_badges    user_badges[]

  @@unique([badge_level, condition_type], map: "uq_badges_level_condition")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model campaigns {
  campaign_id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_name                 String    @db.VarChar(150)
  government_copay_rate_percent Decimal   @default(60) @db.Decimal(5, 2)
  citizen_payment_rate_percent  Decimal   @default(40) @db.Decimal(5, 2)
  daily_quota_limit             Decimal   @default(150) @db.Decimal(10, 2)
  total_quota_limit             Decimal   @default(3000) @db.Decimal(12, 2)
  start_date                    DateTime  @db.Timestamptz(6)
  end_date                      DateTime  @db.Timestamptz(6)
  status                        String    @default("ACTIVE") @db.VarChar(20)
  created_at                    DateTime  @default(now()) @db.Timestamptz(6)
  quests                        quests[]
  wallets                       wallets[]

  @@index([start_date, end_date], map: "idx_campaigns_date_range")
  @@index([status], map: "idx_campaigns_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model daily_social_impact_metrics {
  social_impact_metric_id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metric_date                    DateTime @db.Date
  province                       String?  @db.VarChar(100)
  new_customers_count            Int      @default(0)
  successful_referrals_count     Int      @default(0)
  benefited_merchants_count      Int      @default(0)
  recommendation_spending_amount Decimal  @default(0.00) @db.Decimal(15, 2)
  referral_spending_amount       Decimal  @default(0.00) @db.Decimal(15, 2)
  total_spending_amount          Decimal  @default(0.00) @db.Decimal(15, 2)
  created_at                     DateTime @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([metric_date, province], map: "uq_daily_social_impact_metrics_date_province")
  @@index([metric_date], map: "idx_daily_social_impact_metrics_date")
  @@index([province], map: "idx_daily_social_impact_metrics_province")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fraud_checks {
  fraud_check_id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id       String       @unique(map: "uq_fraud_checks_transaction") @db.Uuid
  user_latitude        Decimal      @db.Decimal(10, 8)
  user_longitude       Decimal      @db.Decimal(11, 8)
  merchant_latitude    Decimal      @db.Decimal(10, 8)
  merchant_longitude   Decimal      @db.Decimal(11, 8)
  distance_meters      Decimal      @db.Decimal(10, 2)
  is_distance_valid    Boolean      @default(true)
  risk_score           Decimal      @default(0) @db.Decimal(5, 2)
  fraud_reason         String?      @db.VarChar(255)
  decision             String       @default("AUTO_APPROVED") @db.VarChar(20)
  reviewed_by_admin_id String?      @db.Uuid
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  transactions         transactions @relation(fields: [transaction_id], references: [transaction_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fraud_checks_transaction")

  @@index([decision], map: "idx_fraud_checks_decision")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model merchants {
  merchant_id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tax_id               String                @unique(map: "uq_merchants_tax_id") @db.VarChar(20)
  shop_name            String                @db.VarChar(100)
  latitude             Decimal               @db.Decimal(10, 8)
  longitude            Decimal               @db.Decimal(11, 8)
  average_rating_stars Decimal               @default(0.0) @db.Decimal(2, 1)
  digital_credit_score Int                   @default(0)
  is_approved          Boolean               @default(false)
  approved_by_admin_id String?               @db.Uuid
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  recommendation_logs  recommendation_logs[]
  referrals            referrals[]
  reviews              reviews[]
  transactions         transactions[]

  @@index([latitude, longitude], map: "idx_merchants_location")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model quests {
  quest_id     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id  String?        @db.Uuid
  reward_id    String?        @db.Uuid
  quest_name   String         @db.VarChar(150)
  description  String?
  quest_type   String         @db.VarChar(50)
  target_value Decimal        @db.Decimal(12, 2)
  starts_at    DateTime       @db.Timestamptz(6)
  ends_at      DateTime       @db.Timestamptz(6)
  status       String         @default("draft") @db.VarChar(20)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  campaigns    campaigns?     @relation(fields: [campaign_id], references: [campaign_id], onUpdate: NoAction, map: "fk_quests_campaign")
  rewards      rewards?       @relation(fields: [reward_id], references: [reward_id], onUpdate: NoAction, map: "fk_quests_reward")
