{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:payment:status": "tsx src/scripts/payment-schema.ts",
    "db:payment:apply": "tsx src/scripts/payment-schema.ts --apply",
    "test:engine": "tsx src/tests/payment-engine.test.ts",
    "test:safety": "tsx --test src/tests/payment-safety.test.ts",
    "test:payment:integration": "tsx src/tests/payment-safety.integration.test.ts",
    "test:badges": "tsx src/tests/badge-management.test.ts && tsx src/tests/admin-badge-auth.test.ts && tsx src/tests/badge-award.test.ts && tsx src/tests/condition-type.test.ts",
    "test:periods": "tsx src/tests/campaign-periods.test.ts && tsx ../client/tests/campaign-period-dates.test.ts",
    "badges:reconcile": "tsx src/scripts/reconcile-badges.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@upstash/redis": "^1.34.4",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "puppeteer-core": "^25.14.0",
    "redis": "^4.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
