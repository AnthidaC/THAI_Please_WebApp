VITE_API_URL=http://localhost:5000/api
# Optional account selection when the database has more than one test-marked account per role.
VITE_DEMO_CITIZEN_USER_ID=
VITE_DEMO_MERCHANT_ID=
VITE_DEMO_ADMIN_STAFF_ID=

# FEATURE FLAG: ควบคุมการบังคับอัปโหลดเอกสารสมัครร้านค้า (default: true)
# ตั้งเป็น 'false' เพื่อปิดการแนบเอกสารชั่วคราว
VITE_MERCHANT_REQUIRE_DOCUMENTS=true
